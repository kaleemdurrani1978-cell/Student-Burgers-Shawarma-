# =========================================================================
# STUDENT SHAWARMA & FAST FOOD — ENVIRONMENT CONFIGURATION
# =========================================================================

# The public site URL (set in Vercel production to your deployed domain, e.g. https://student-shawarma.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Dashboard Security PIN / Password (Default for initial setup: change immediately in production)
ADMIN_SECRET_KEY=student2026_admin

# Restaurant WhatsApp Configuration
# Verified number from Facebook / Menu: 0309-4222283
# Pakistani format for wa.me URL: 923094222283
NEXT_PUBLIC_DEFAULT_WHATSAPP=923094222283

# Optional: Supabase PostgreSQL & Storage configuration
# If not configured, the app seamlessly runs using the built-in resilient local file database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
